      "rows": null,
      "section_path": [
        "Manager Approval Dashboard",
        "Process the queue"
      ],
      "text": "Confirm that the decision appears in history and the pending count falls.",
      "type": "list_item"
    },
    {
      "heading_level": null,
      "is_semantic": true,
      "list_level": null,
      "location": {
        "bbox": [
