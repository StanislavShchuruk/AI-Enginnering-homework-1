          262.2529296875,
          578.791015625
        ],
        "element": null,
        "line": null,
        "page": 1,
        "part": null
      },
      "marker": null,
      "ordered": null,
      "rows": null,
      "section_path": [
        "Manager Approval Dashboard",
        "Concurrency and confidentiality"
      ],
      "text": "Concurrency and confidentiality",
      "type": "heading"
    },
    {
      "heading_level": null,
      "is_semantic": true,
      "list_level": null,
      "location": {
        "bbox": [
          63.599998474121094,
          584.0125122070312,
          523.5003051757812,
          670.9395141601562
        ],
        "element": null,
        "line": null,
        "page": 1,
        "part": null
      },
      "marker": null,
      "ordered": null,
      "rows": null,
      "section_path": [
        "Manager Approval Dashboard",
        "Concurrency and confidentiality"
      ],
      "text": "APPROVAL-409 means someone else acted on the request after it was opened. Reload the record and read the saved decision before taking another action. A delegated manager may act only while the delegation is active. Managers can see absence dates and the evidence-complete indicator but not confidential medical attachments. A payroll lock discovered during attendance approval blocks ledger changes and routes the matter to HR Payroll. Do not clear the lock or reclassify a request merely to remove it from the queue.",
      "type": "paragraph"
    },
    {
      "heading_level": 2,
      "is_semantic": true,
      "list_level": null,
      "location": {
        "bbox": [
          63.599998474121094,
          682.8900146484375,
          206.63900756835938,
          700.791015625
        ],
        "element": null,
        "line": null,
        "page": 1,
        "part": null
      },
      "marker": null,
      "ordered": null,
      "rows": null,
      "section_path": [
        "Manager Approval Dashboard",
        "Handover to a delegate"
      ],
      "text": "Handover to a delegate",
      "type": "heading"
    },
    {
      "heading_level": null,
      "is_semantic": true,
      "list_level": null,
      "location": {
        "bbox": [
          63.599998474121094,
          706.0125122070312,
          531.8403930664062,
          763.9395141601562
        ],
        "element": null,
        "line": null,
        "page": 1,
        "part": null
      },
      "marker": null,
      "ordered": null,
      "rows": null,
      "section_path": [
        "Manager Approval Dashboard",
        "Handover to a delegate"
      ],
      "text": "Before going on leave, check that the delegate's team and active dates are correct. The delegate can act only during that period and does not gain access to medical attachments or payment destinations. If an action is missing, check the selected organization and role rather than using another person's session.",
      "type": "paragraph"
    },
