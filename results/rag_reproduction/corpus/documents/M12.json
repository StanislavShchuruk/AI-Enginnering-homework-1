      "section_path": [
        "Employee Documents & E-Signatures",
        "Document workspace"
      ],
      "text": "My documents separates employee uploads, assigned acknowledgements, and signature packages. Uploading a file does not mean HR has accepted it, and acknowledging a policy does not execute a contract amendment. Document status can be Uploaded, Under review, Accepted, Rejected, Awaiting signature, or Completed. A signature package must contain the approved terms before it is sent to the employee.",
      "type": "paragraph"
    },
    {
      "heading_level": 2,
      "is_semantic": true,
      "list_level": null,
      "location": {
        "bbox": null,
        "element": 6,
        "line": null,
        "page": null,
        "part": null
      },
      "marker": null,
      "ordered": null,
      "rows": null,
      "section_path": [
        "Employee Documents & E-Signatures",
        "Upload and review"
      ],
      "text": "Upload and review",
      "type": "heading"
    },
    {
      "heading_level": null,
      "is_semantic": true,
      "list_level": 0,
      "location": {
        "bbox": null,
        "element": 8,
        "line": null,
