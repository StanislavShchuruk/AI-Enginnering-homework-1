      "section_path": [
        "PeopleFlow Release Notes v1.8"
      ],
      "text": "Released 2026-03-01. These notes cover the version used through 2026-08-31. PeopleFlow Release Notes v2.0 describe the changes introduced on 2026-09-01.",
      "type": "paragraph"
    },
    {
      "heading_level": 2,
      "is_semantic": true,
      "list_level": null,
      "location": {
        "bbox": null,
