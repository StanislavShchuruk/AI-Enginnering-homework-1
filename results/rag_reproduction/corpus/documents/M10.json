        "Overtime & Time-Off-in-Lieu Guide",
        "Separate permission from recorded time"
      ],
      "text": "Separate permission from recorded time",
      "type": "heading"
    },
    {
      "heading_level": null,
      "is_semantic": true,
      "list_level": null,
      "location": {
        "bbox": null,
