          280.9394836425781
        ],
        "element": null,
        "line": null,
        "page": 1,
        "part": null
      },
      "marker": "3.",
      "ordered": true,
      "rows": null,
      "section_path": [
        "Sick Leave Reporting Guide",
        "Record the period"
      ],
      "text": "Upload evidence only in the confidential medical attachment field if required.",
      "type": "list_item"
    },
    {
      "heading_level": null,
      "is_semantic": true,
      "list_level": 0,
      "location": {
        "bbox": [
          63.599998474121094,
          289.0124816894531,
          452.898193359375,
          303.4394836425781
        ],
        "element": null,
        "line": null,
        "page": 1,
        "part": null
      },
      "marker": "4.",
      "ordered": true,
      "rows": null,
      "section_path": [
        "Sick Leave Reporting Guide",
        "Record the period"
      ],
      "text": "Submit, then check that the absence status reads Reported or Evidence pending.",
      "type": "list_item"
    },
    {
      "heading_level": null,
      "is_semantic": true,
      "list_level": null,
      "location": {
        "bbox": [
          63.599998474121094,
          311.5124816894531,
          531.8402709960938,
