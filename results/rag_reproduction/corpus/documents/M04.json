      "marker": "1.",
      "ordered": true,
      "rows": null,
      "section_path": [
        "Sick Leave Reporting Guide",
        "Record the period"
      ],
      "text": "Select the first missed scheduled workday and the expected final missed workday.",
      "type": "list_item"
    },
    {
      "heading_level": null,
      "is_semantic": true,
      "list_level": 0,
      "location": {
        "bbox": [
