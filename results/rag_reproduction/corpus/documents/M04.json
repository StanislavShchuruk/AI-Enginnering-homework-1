          258.4394836425781
        ],
        "element": null,
        "line": null,
        "page": 1,
        "part": null
      },
      "marker": "2.",
      "ordered": true,
      "rows": null,
      "section_path": [
        "Sick Leave Reporting Guide",
        "Record the period"
      ],
      "text": "Choose Sickness as the absence type and indicate whether the report is new or an extension.",
      "type": "list_item"
    },
    {
      "heading_level": null,
      "is_semantic": true,
      "list_level": 0,
      "location": {
        "bbox": [
