      "rows": null,
      "section_path": [
        "Employee Profile Management",
        "A change taking effect next month"
      ],
      "text": "A change taking effect next month",
      "type": "heading"
    },
    {
      "heading_level": null,
      "is_semantic": true,
      "list_level": null,
      "location": {
        "bbox": [
