      "ordered": true,
      "rows": null,
      "section_path": [
        "Employee Profile Management",
        "Update contact information"
      ],
      "text": "Review the old and proposed values on the confirmation panel.",
      "type": "list_item"
    },
    {
      "heading_level": null,
      "is_semantic": true,
