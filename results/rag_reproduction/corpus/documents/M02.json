        "Validation and privacy"
      ],
      "text": "Validation and privacy",
      "type": "heading"
    },
    {
      "heading_level": null,
      "is_semantic": true,
      "list_level": null,
      "location": {
        "bbox": [
          63.599998474121094,
          425.0124816894531,
          531.8402709960938,
          482.9394836425781
        ],
        "element": null,
        "line": null,
        "page": 1,
        "part": null
      },
      "marker": null,
      "ordered": null,
      "rows": null,
      "section_path": [
        "Employee Profile Management",
        "Validation and privacy"
      ],
      "text": "An address requires street, city, country, and postal code where the selected country uses one. Phone input accepts a leading plus sign and 7 to 15 digits; spaces and hyphens are removed for validation. PROFILE-422 means a required value failed validation. PROFILE-409 means another edit was saved after the form opened; reload and compare values before resubmitting.",
      "type": "paragraph"
    },
    {
