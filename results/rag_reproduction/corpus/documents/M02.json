      "rows": null,
      "section_path": [
        "Employee Profile Management",
        "Update contact information"
      ],
      "text": "Enter the new contact details and choose the date the address becomes effective.",
      "type": "list_item"
    },
    {
      "heading_level": null,
      "is_semantic": true,
      "list_level": 0,
