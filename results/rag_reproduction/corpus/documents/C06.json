      ],
      "text": "Credits and adjustments",
      "type": "heading"
    },
    {
      "heading_level": null,
      "is_semantic": true,
      "list_level": null,
      "location": {
        "bbox": [
          63.599998474121094,
          494.0124816894531,
          529.3277587890625,
          580.9395141601562
        ],
        "element": null,
        "line": null,
        "page": 1,
        "part": null
      },
      "marker": null,
      "ordered": null,
      "rows": null,
      "section_path": [
        "Overtime & TOIL Policy",
        "Credits and adjustments"
      ],
      "text": "TOIL is capped at 40 hours and expires 90 calendar days after the overtime work date. Managers must split an award or change the compensation choice before approving a credit that would exceed the cap. Approved TOIL absence consumes the oldest unexpired credit first. Expiry does not automatically create a cash payment. Payroll cutoff is the 20th calendar day at 17:00 UTC. A later attendance correction requires a linked overtime recalculation, with the old award and any balancing entry retained in audit history.",
      "type": "paragraph"
    },
