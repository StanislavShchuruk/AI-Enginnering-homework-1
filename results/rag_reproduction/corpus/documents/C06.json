          220.34097290039062,
          381.2909851074219
        ],
        "element": null,
        "line": null,
        "page": 1,
        "part": null
      },
      "marker": null,
      "ordered": null,
      "rows": null,
      "section_path": [
        "Overtime & TOIL Policy",
        "Calculation and rounding"
      ],
      "text": "Calculation and rounding",
      "type": "heading"
    },
    {
      "heading_level": null,
      "is_semantic": true,
      "list_level": null,
      "location": {
        "bbox": [
          63.599998474121094,
          386.5124816894531,
          525.7892456054688,
          458.9394836425781
        ],
        "element": null,
        "line": null,
        "page": 1,
        "part": null
      },
      "marker": null,
      "ordered": null,
      "rows": null,
      "section_path": [
        "Overtime & TOIL Policy",
        "Calculation and rounding"
      ],
      "text": "Cash overtime pays 1.5 times the contract hourly base. Derive an hourly base from annual salary divided by 52 and then by contracted weekly hours; keep intermediate precision and round the final earnings line to two currency decimals. TOIL awards 1.5 hours per approved overtime hour and keeps balances in quarter-hour increments. Two eligible overtime hours generate three TOIL hours. The same work cannot produce both cash and TOIL.",
      "type": "paragraph"
    },
    {
      "heading_level": 2,
      "is_semantic": true,
      "list_level": null,
      "location": {
        "bbox": [
          63.599998474121094,
          470.8899841308594,
          215.29696655273438,
          488.7909851074219
        ],
