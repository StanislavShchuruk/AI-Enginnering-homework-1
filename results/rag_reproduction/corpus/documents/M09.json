      ],
      "text": "Gross pay and net pay",
      "type": "heading"
    },
    {
      "heading_level": null,
      "is_semantic": true,
      "list_level": null,
      "location": {
        "bbox": [
          63.599998474121094,
          425.0124816894531,
          529.3487548828125,
          497.4394836425781
        ],
        "element": null,
        "line": null,
        "page": 1,
        "part": null
      },
      "marker": null,
      "ordered": null,
      "rows": null,
      "section_path": [
        "Payslip & Payroll Portal Guide",
        "Gross pay and net pay"
      ],
      "text": "Gross pay is the sum of base pay and eligible earnings. Net pay equals gross pay minus the displayed deductions; reimbursement lines are shown separately if the organization enables them. A payment marked Submitted confirms that the export was sent, not that funds settled. Allow two business days after the stated pay date before reporting a settlement delay, unless the destination is visibly incorrect.",
      "type": "paragraph"
    },
