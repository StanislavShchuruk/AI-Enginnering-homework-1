      "rows": null,
      "section_path": [
        "Employee Data Privacy Policy",
        "Access approval and audit"
      ],
      "text": "Access approval and audit",
      "type": "heading"
    },
    {
      "heading_level": null,
      "is_semantic": true,
      "list_level": null,
      "location": {
        "bbox": [
          63.599998474121094,
          250.01248168945312,
          531.840087890625,
          322.4394836425781
        ],
        "element": null,
        "line": null,
        "page": 1,
        "part": null
      },
      "marker": null,
      "ordered": null,
      "rows": null,
      "section_path": [
        "Employee Data Privacy Policy",
        "Access approval and audit"
      ],
      "text": "Role requests require a business purpose and approval by the module owner. Access expires when a temporary assignment ends. HR reviews privileged roles quarterly on 15 January, 15 April, 15 July, and 15 October. The application records actor role, operation, record reference, timestamp in UTC, and decision outcome for sensitive changes. Audit logs must not contain passwords, reset links, MFA recovery secrets, or complete medical attachment text.",
      "type": "paragraph"
    },
