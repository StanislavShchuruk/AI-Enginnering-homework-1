      "text": "Requests and incidents",
      "type": "heading"
    },
    {
      "heading_level": null,
      "is_semantic": true,
      "list_level": null,
      "location": {
        "bbox": [
          63.599998474121094,
          601.5125122070312,
          529.894775390625,
          688.4395141601562
        ],
        "element": null,
        "line": null,
        "page": 1,
        "part": null
      },
      "marker": null,
      "ordered": null,
      "rows": null,
      "section_path": [
        "Employee Data Privacy Policy",
        "Requests and incidents"
      ],
      "text": "An employee may request access or a correction through the secure Privacy request form. HR acknowledges within two business days and targets completion within 20 calendar days, subject to a documented investigation hold. Identity verification must precede disclosure. Wrong-recipient exports, exposed medical files, and unauthorized payroll views are security incidents under Support Escalation & Security Incidents. Do not attach the exposed information to another ordinary ticket. Preserve a restricted reference and ask the security response group to control further sharing.",
      "type": "paragraph"
    },
