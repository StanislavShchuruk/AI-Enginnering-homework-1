      "rows": null,
      "section_path": [
        "Employee Data Privacy Policy",
        "Who may access employee records"
      ],
      "text": "Employees can inspect their own profile, payslips, attendance, and signed packages. Managers can inspect team schedules, approval requests, and absence dates. HR absence administrators alone can inspect medical attachments. Payroll Operations can inspect payroll earnings and verified payment destinations. Each role must be limited to the fields needed for its assigned work.",
      "type": "paragraph"
    },
    {
      "heading_level": 2,
      "is_semantic": true,
      "list_level": null,
      "location": {
        "bbox": [
