      "section_path": [
        "Full-Time Employment Contract C",
        "Retention and administrative review"
      ],
      "text": "The Employee Data Privacy Policy governs access to confidential records. A disputed administrative calculation may be referred to HR within 10 calendar days of notification. HR targets a written response within five business days; the original attendance and signed terms remain intact during review.",
      "type": "paragraph"
    },
