      "marker": null,
      "ordered": null,
      "rows": null,
      "section_path": [
        "Full-Time Employment Contract C",
        "Remuneration"
      ],
      "text": "Annual base salary is USD 62,400.00, payable in 12 equal gross monthly installments, less applicable deductions. HR Payroll maintains the verified payment destination; a support attachment cannot amend it. Payroll cutoff is the 20th calendar day at 17:00 UTC. Published payslips appear by 18:00 UTC on the last business day of the month. Allow up to two business days after the stated pay date for settlement.",
      "type": "paragraph"
    },
