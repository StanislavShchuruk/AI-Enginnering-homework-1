        "Payroll Troubleshooting",
        "Identify the payroll stage"
      ],
      "text": "Identify the payroll stage",
      "type": "heading"
    },
    {
      "heading_level": null,
      "is_semantic": true,
      "list_level": null,
      "location": {
        "bbox": null,
