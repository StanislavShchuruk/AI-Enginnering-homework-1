      "section_path": [
        "Manager FAQ",
        "Does more attendance mean automatic overtime?"
      ],
      "text": "No. Check prior approval and the actual-work interval. The 1.5 multiplier, 8-hour weekly overtime limit, 48-hour total-work limit and 40-hour TOIL cap still apply.",
      "type": "paragraph"
