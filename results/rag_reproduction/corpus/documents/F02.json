      "section_path": [
        "Manager FAQ",
        "Must I approve a leave cancellation?"
      ],
      "text": "Employees cancel pending or approved annual leave before its first scheduled shift starts. You receive a notification; no further approval is needed. Started leave requires HR review. The former instruction to contact HR Support is historical.",
      "type": "paragraph"
    },
