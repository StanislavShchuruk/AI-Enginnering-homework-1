      "text": "Historical scope",
      "type": "heading"
    },
    {
      "heading_level": null,
      "is_semantic": true,
      "list_level": null,
      "location": {
        "bbox": [
          63.599998474121094,
          114.01248931884766,
          525.2432250976562,
          157.43948364257812
        ],
        "element": null,
