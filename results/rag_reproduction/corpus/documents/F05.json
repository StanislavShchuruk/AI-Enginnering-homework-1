      "section_path": [
        "Leave Request Guide v1",
        "Historical scope and entitlement"
      ],
      "text": "This edition applied from 2026-03-01 through 2026-08-31. From 2026-09-01 use Leave Request Guide v2, including for new actions on existing requests. Annual entitlements in this edition were A: 25 days, B: 15 days, and C: 28 days.",
      "type": "paragraph"
    },
    {
      "heading_level": 2,
      "is_semantic": true,
      "list_level": null,
      "location": {
        "bbox": [
          63.599998474121094,
