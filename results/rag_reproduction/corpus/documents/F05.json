      },
      "marker": "1.",
      "ordered": true,
      "rows": null,
      "section_path": [
        "Leave Request Guide v1",
        "Submit leave in v1.8"
      ],
      "text": "Open My time > Leave and choose Annual leave.",
      "type": "list_item"
    },
    {
      "heading_level": null,
      "is_semantic": true,
      "list_level": 0,
      "location": {
        "bbox": [
